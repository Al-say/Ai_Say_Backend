# ============================================
# 环境变量配置模板
# ============================================
# 将此文件复制为 .env 并填入真实值
# 注意：.env 已被 .gitignore 排除，确保不会提交到 Git
#
# 使用方法：
# 1. IDEA: Run -> Edit Configurations -> Environment Variables
# 2. 命令行: export DEEPSEEK_API_KEY=sk-xxx && mvn spring-boot:run
# 3. Docker: 在 docker-compose.yml 中配置 environment
# ============================================

# DeepSeek AI 配置
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# JWT 认证配置（生产环境必须修改为随机生成的强密钥）
JWT_SECRET=YourSuperSecretKeyHereMustBeVeryLongAndComplex123!AtLeast32Characters
JWT_EXPIRATION=86400000  # 24 小时（毫秒）

# 百度 ASR 配置
BAIDU_APP_ID=your-app-id
BAIDU_API_KEY=your-api-key
BAIDU_SECRET_KEY=your-secret-key

# Apple 登录配置
APPLE_CLIENT_ID=com.zhupinzan.speaking
APPLE_TOKEN_SECRET=your-apple-secret
APPLE_JWT_ISSUER=com.zhupinzan.speaking
APPLE_JWT_AUDIENCE=com.zhupinzan.speaking

# S3/MinIO 存储配置
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=speaking-audio
S3_REGION=us-east-1

# 数据库配置（如果使用 PostgreSQL）
# DB_URL=jdbc:postgresql://localhost:5432/speaking_db
# DB_USERNAME=postgres
# DB_PASSWORD=your-password
