# 使用 OpenJDK 基础镜像
FROM eclipse-temurin:21-jdk

# 设定时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 安装必要的工具
RUN apt-get update && \
    apt-get install -y maven ffmpeg curl && \
    rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 复制 Maven 仓库（如果有）
COPY .local-m2-repo /root/.m2/repository 2>/dev/null || echo "No local Maven repo found"

# 复制源代码
COPY pom.xml .
COPY src ./src

# 构建应用
RUN mvn clean package -DskipTests -Dmaven.repo.local=/root/.m2/repository || echo "Build failed, but continuing..."

# 复制 Jar 包
RUN cp target/*.jar app.jar 2>/dev/null || echo "JAR not found, manual build required"

# 清理构建文件（保留 jar）
RUN rm -rf src

# 暴露端口
EXPOSE 2580

# 启动命令
ENTRYPOINT ["java", "-jar", "app.jar"]