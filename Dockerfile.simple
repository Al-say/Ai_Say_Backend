FROM amazoncorretto:21

# 设定时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 安装 FFmpeg（静态二进制，适用 Amazon Linux / x86_64）
RUN dnf install -y xz tar curl && \
    curl -L "https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz" \
      | tar xJ -C /tmp && \
    mv /tmp/ffmpeg-*-static/ffmpeg  /usr/bin/ffmpeg  && \
    mv /tmp/ffmpeg-*-static/ffprobe /usr/bin/ffprobe && \
    chmod +x /usr/bin/ffmpeg /usr/bin/ffprobe && \
    rm -rf /tmp/ffmpeg* && \
    dnf clean all && \
    ffmpeg -version 2>&1 | head -1

# 创建上传目录
RUN mkdir -p /app/uploads

# 设置工作目录
WORKDIR /app

# 复制jar包
COPY target/speaking-0.0.1-SNAPSHOT.jar app.jar

# 暴露端口
EXPOSE 2580

# 启动命令
ENTRYPOINT ["java", "-jar", "app.jar"]